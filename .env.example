# Banco de Dados (Configuração para o TypeORM)
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=user_concursos
DB_PASSWORD=user_password
DB_DATABASE=concursos_db

# Mensageria (Configuração para o NestJS Microservices)
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_QUEUE=concursos.new

# Telegram (Crie seu token com o @BotFather)
TELEGRAM_BOT_TOKEN=seu_token_aqui

# Stripe
STRIPE_SECRET_KEY=sk_test_sua_chave_aqui
STRIPE_PRICE_ID=price_seu_id_aqui
STRIPE_WEBHOOK_SECRET=whsec_seu_secret_aqui

# Monitoramento (opcional — ativa alertas de DLQ via Telegram)
RABBITMQ_MANAGEMENT_URL=http://localhost:15672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
ADMIN_TELEGRAM_ID=seu_telegram_id_aqui
# Stripe redirect pages (optional; defaults are placeholders)
STRIPE_SUCCESS_URL=https://seusite.com/sucesso
STRIPE_CANCEL_URL=https://seusite.com/cancelado

# HTTP port (default 3000)
PORT=3000

# Optional: point the bot at a fake Telegram Bot API (used by `npm run smoke`)
# TELEGRAM_API_ROOT=http://localhost:9999

# Vacancy scraper (all optional)
# Sources to read, comma separated (pci-concursos, cebraspe).
# Default: every source in development, none in production.
# SCRAPER_ENABLED_SOURCES=cebraspe
# Minutes between runs (at least 15 in production, default 60)
# SCRAPER_INTERVAL_MINUTES=60
# Run once right after start-up
# SCRAPER_RUN_ON_START=false
